# ============ 运行环境 ============
NODE_ENV=production
# Nginx 反向代理时只监听本机
HOST=127.0.0.1
PORT=3000
# Nginx 在 127.0.0.1 前面，必须开启信任代理，否则限流和 Secure Cookie 判断会异常
TRUST_PROXY=1
# 线上域名，必须与浏览器地址完全一致（协议 + 域名，无末尾斜杠）
APP_ORIGIN=https://photos.example.com

# ============ 数据目录 ============
# 相对路径以项目根目录为基准；生产建议使用绝对路径 /opt/moon-isle/data
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
# 上传分片临时目录，不要放在可公开访问的 /uploads 下
UPLOAD_TMP_DIR=./data/uploads-tmp

# ============ 上传限制 ============
MAX_IMAGE_MB=80
MAX_VIDEO_MB=2048
# 分片大小；Nginx client_max_body_size 需要大于此值
CHUNK_SIZE_MB=8
MAX_MEDIA=5000

# ============ 登录 / 安全 ============
SESSION_TTL_DAYS=7
# 生产环境必须 true；只有本地 http 调试时才改成 false
COOKIE_SECURE=true
BCRYPT_ROUNDS=12

# ============ 初始管理员 ============
# 方式 A：首次启动前填写 ADMIN_PASSWORD（至少 10 位）。
#         服务首次启动且 users 表为空时会自动创建管理员。
#         创建成功后请从 .env 删除该明文密码，或改为空。
# 方式 B：ADMIN_PASSWORD 留空，启动服务后运行：
#         npm run create-admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ============ 视频封面（可选） ============
# 安装 ffmpeg 后，视频会上传并截取封面；未安装则使用占位封面，不影响上传。
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
